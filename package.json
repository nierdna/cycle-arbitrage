{
  "name": "cycle-arbitrage-mvp",
  "version": "0.1.0",
  "description": "MVP Cycle Arbitrage bot for PancakeSwap V3 on BSC",
  "type": "module",
  "main": "dist/cycleArbitrage.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx examples/main.ts",
    "start:prod": "node dist/examples/main.js",
    "dev": "tsx watch examples/main.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pm2:start": "npm run build && pm2 start ecosystem.config.cjs --only cycle-arbitrage",
    "pm2:start:dev": "pm2 start ecosystem.config.cjs --only cycle-arbitrage-dev",
    "pm2:stop": "pm2 stop cycle-arbitrage",
    "pm2:restart": "pm2 restart cycle-arbitrage",
    "pm2:restart:build": "npm run build && pm2 restart cycle-arbitrage",
    "pm2:logs": "pm2 logs cycle-arbitrage",
    "pm2:status": "pm2 status",
    "pm2:delete": "pm2 delete cycle-arbitrage",
    "transfer:bnb": "tsx examples/transferBNB.ts"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "dotenv": "^17.2.3",
    "ethers": "^6.9.0",
    "express": "^4.18.2",
    "uniswap-v3-quoter": "^0.3.0",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@vitest/coverage-v8": "^1.6.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
